+@dataclass(frozen=True, slots=True)
+class Stats:
+    """Snapshot of the statistics for a growing/sliding window."""
+
+    size: int
+    minimum: object
+    median: object
+    maximum: object
+    mean: object
+
+
+def _running_extreme(iterable, maxlen, *, is_min):
+    """Monotone deque rolling extrema, including growing initial windows."""
+    if maxlen is not None and maxlen <= 0:
+        raise ValueError('maxlen must be a positive integer')
+    it = iter(iterable)
+
+    def generate():
+        candidates = deque()
+        for index, value in enumerate(it):
+            while candidates and (
+                value <= candidates[-1][1] if is_min
+                else value >= candidates[-1][1]
+            ):
+                candidates.pop()
+            candidates.append((index, value))
+            if maxlen is not None:
+                while candidates and index - candidates[0][0] >= maxlen:
+                    candidates.popleft()
+            yield candidates[0][1]
+
+    return generate()
+
+
+def running_min(iterable, *, maxlen=None):
+    """Yield the minimum within every growing or fixed-length prefix."""
+    return _running_extreme(iterable, maxlen, is_min=True)
+
+
+def running_max(iterable, *, maxlen=None):
+    """Yield the maximum within every growing or fixed-length prefix."""
+    return _running_extreme(iterable, maxlen, is_min=False)
+
+
+def running_statistics(iterable, *, maxlen=None):
+    """Yield immutable Stats objects for each running window."""
+    iterator = iter(iterable)
+    if maxlen is not None and maxlen <= 0:
+        raise ValueError('maxlen must be a positive integer')
+    from .recipes import running_mean, running_median
+    minimums, medians, maximums, means = tee(iterator, 4)
+
+    def generate():
+        sources = zip(
+            running_min(minimums, maxlen=maxlen),
+            running_median(medians, maxlen=maxlen),
+            running_max(maximums, maxlen=maxlen),
+            running_mean(means, maxlen=maxlen),
+        )
+        for index, (minimum, med, maximum, avg) in enumerate(sources, start=1):
+            yield Stats(size=min(index, maxlen) if maxlen is not None else index,
+                        minimum=minimum, median=med, maximum=maximum, mean=avg)
+
+    return generate()
