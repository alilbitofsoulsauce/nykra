      "source": "def parse_dfxp_time_expr(time_expr):\n    if not time_expr:\n        return\n\n    mobj = re.match(r'^(?P<time_offset>\\d+(?:\\.\\d+)?)s?$', time_expr)\n    if mobj:\n        return float(mobj.group('time_offset'))\n\n    mobj = re.match(r'^(?P<hours>\\d+):(?P<minutes>\\d{2}):(?P<seconds>\\d{2}(?:\\.\\d+)?)$', time_expr)\n    if mobj:\n        return (\n            3600 * int(mobj.group('hours'))\n            + 60 * int(mobj.group('minutes'))\n            + float(mobj.group('seconds'))\n        )\n\n    mobj = re.match(r'^(?P<hours>\\d+):(?P<minutes>\\d{2}):(?P<seconds>\\d{2}):(?P<frames>\\d+)(?:\\.(?P<subframes>\\d+))?$', time_expr)\n    if mobj:\n        hours = int(mobj.group('hours'))\n        minutes = int(mobj.group('minutes'))\n        seconds = int(mobj.group('seconds'))\n        frames = int(mobj.group('frames'))\n        subframes = mobj.group('subframes')\n        return 3600 * hours + 60 * minutes + seconds + frames / 30.0 + (float('0.' + subframes) / 30.0 if subframes else 0)\n",
